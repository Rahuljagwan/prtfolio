# Copy this file to .env (local) and set the same variables in Vercel > Project > Settings > Environment Variables.
# Never commit .env.

# Neon pooled connection string (runtime, used by the site). Host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string (used only by `prisma migrate`). Same as above but without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Password for the /admin page. Use a long, unique one (16+ characters).
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Random string used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-64-random-hex-characters"

# OPTIONAL: AI-written assistant answers. Leave unset to keep the free local assistant (no external calls).
# Server-side only: never prefix with NEXT_PUBLIC_ and never commit the real key.
# ASSISTANT_LLM_API_KEY=""
# ASSISTANT_LLM_MODEL="claude-haiku-4-5-20251001"
# ASSISTANT_LLM_DAILY_CAP="200"
